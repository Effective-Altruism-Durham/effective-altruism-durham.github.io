---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Success">
  <section class="relative min-h-[70vh] flex items-center justify-center py-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <!-- Geometric Background Decorative Elements -->
    <div class="absolute inset-0 -z-10 pointer-events-none opacity-40">
      <div class="absolute top-10 left-10 w-72 h-72 rounded-full bg-ea-active-teal/5 blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 rounded-full bg-ea-dark-teal/5 blur-3xl"></div>
      <div class="absolute top-1/2 left-1/3 w-64 h-64 bg-radial from-ea-active-teal/10 to-transparent blur-2xl"></div>
      <!-- Grid -->
      <svg class="absolute inset-0 w-full h-full stroke-ea-dark-teal/5" aria-hidden="true">
        <defs>
          <pattern id="success-grid-pattern" width="40" height="40" patternUnits="userSpaceOnUse" x="-1" y="-1">
            <path d="M.5 40V.5H40" fill="none" stroke-width="0.5" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#success-grid-pattern)" />
      </svg>
    </div>

    <div class="max-w-md w-full text-center space-y-8 animate-fade-in">
      <div class="bg-white rounded-3xl p-8 sm:p-10 border border-ea-dark-teal/5 shadow-2xl space-y-6">
        <!-- Animated Success Circle Icon -->
        <div class="mx-auto w-16 h-16 sm:w-20 sm:h-20 bg-ea-active-teal/10 text-ea-active-teal rounded-full flex items-center justify-center shadow-inner relative">
          <!-- Green checkmark icon -->
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-8 h-8 sm:w-10 sm:h-10">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
          <!-- Pulsating ring -->
          <span class="absolute inset-0 rounded-full border-4 border-ea-active-teal/20 animate-ping"></span>
        </div>

        <!-- Success Text -->
        <div class="space-y-3">
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-ea-dark-teal font-ea-heading">
            Message Sent!
          </h1>
          <p class="text-sm sm:text-base text-ea-text-secondary font-ea-body leading-relaxed font-medium">
            Thank you for reaching out. We have received your message and will get back to you as soon as possible.
          </p>
        </div>

        <!-- Return to Home CTA -->
        <div class="pt-2">
          <a
            href="/"
            class="w-full inline-flex items-center justify-center px-6 py-3.5 bg-ea-dark-teal hover:bg-ea-active-teal text-white font-bold text-sm uppercase tracking-widest rounded-xl transition-all duration-300 transform hover:-translate-y-0.5 shadow-md hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-ea-active-teal focus:ring-offset-2"
          >
            Return to Homepage
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
