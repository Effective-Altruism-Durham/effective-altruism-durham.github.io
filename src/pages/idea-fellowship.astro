---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BrandButton from '../components/BrandButton.astro';
import PageFrame from '../components/PageFrame.astro';
---

<Layout
	title="In-Depth EA (IDEA) Fellowship | EA Durham"
	description="The IDEA (In-Depth EA) Fellowship is an eight-week continuation programme open to fellows who have completed the Arête Fellowship."
>
	<SiteHeader />

	<PageFrame title="IDEA Fellowship">
			<!-- Main Content Card -->
			<div class="ea-card ea-card-hover p-8 md:p-12">
				<!-- Text Block -->
				<div
					class="prose ea-copy max-w-none text-[16px] md:text-[18px] leading-[1.8] space-y-6 mb-12"
				>
					<p>
						The IDEA (In-Depth EA) Fellowship is open to everybody who has
						completed the Arête Fellowship. It’s an eight-week programme,
						beginning with two weeks of setting intentions and thinking about
						our own values and how we arrive at them, followed by 6 weeks where
						your fellowship group decides together which topics to cover.
					</p>
				</div>

				<!-- Section Accent Divider -->
				<hr class="ea-divider" />

				<!-- Action Buttons -->
				<div
					class="flex flex-col sm:flex-row items-center justify-center gap-5"
				>
					<!-- Syllabus Link -->
					<BrandButton
						href="https://facebook.us20.list-manage.com/track/click?u=846ffa2626e646922cd7f33ab&id=7204fdf8d5&e=d6a9aecbb6"
						external
						class="h-[54px] w-full sm:w-[268px] text-[16px]"
					>
						<span>View Syllabus</span>
						<svg
							viewBox="0 0 24 24"
							class="h-5 w-5 fill-none stroke-current stroke-2"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
							></path>
						</svg>
					</BrandButton>

					<!-- Back Button -->
					<BrandButton
						href="/programmes"
						variant="outline-teal"
						class="h-[54px] w-full sm:w-[268px] text-[16px]"
					>
						<svg
							viewBox="0 0 24 24"
							class="h-5 w-5 fill-none stroke-current stroke-2"
							aria-hidden="true"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
						</svg>
						<span>Back to Programmes</span>
					</BrandButton>
				</div>
			</div>
	</PageFrame>

	<SiteFooter />
</Layout>
