---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import ContactTeam from "../components/ContactTeam.astro";
import { getContactTeam } from "../lib/contact-team";
import { islands } from "../lib/islands";

const contactTeam = await getContactTeam();
---

<Layout
  title="Contact Us - Effective Altruism Durham"
  description="Contact the Effective Altruism Durham committee members. Find roles, email addresses, and bios for our organizers."
>
  <SiteHeader />
  
  <main class="w-full bg-white">
    <TinaIsland name="contact-team" wrapper={islands["contact-team"].wrapper}>
      <ContactTeam data={contactTeam.data} />
    </TinaIsland>
  </main>
  
  <SiteFooter />
</Layout>
