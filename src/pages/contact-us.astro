---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PersonCard from "../components/PersonCard.astro";

interface Person {
  name: string;
  roles: string;
  email: string;
  bio: string;
  image: string;
  order?: number;
}

const memberModules = import.meta.glob("../../content/team-members/*.json", {
  eager: true,
});
const people = Object.values(memberModules)
  .map((entry) => (entry as { default: Person }).default)
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999));
---

<Layout
  title="Contact Us - Effective Altruism Durham"
  description="Contact the Effective Altruism Durham committee members. Find roles, email addresses, and bios for our organizers."
>
  <SiteHeader />
  
  <main class="w-full bg-white">
    <div class="mx-auto w-full max-w-[1200px] px-6 pt-[52px] pb-24 sm:px-8 lg:px-0">
      <h1 class="mb-[54px] text-center font-ea-heading text-[44px] font-normal leading-none text-[#054d5a] sm:text-[56px]">
        Contact Us
      </h1>
      
      <div class="flex flex-col gap-[124px]">
        {people.map((person) => (
          <PersonCard {...person} />
        ))}
      </div>
      
    </div>
  </main>
  
  <SiteFooter />
</Layout>
