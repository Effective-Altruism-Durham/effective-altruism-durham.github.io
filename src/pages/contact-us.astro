---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Team from '../components/Team.astro';
import { getTeam } from '../lib/team';
import { islands } from '../lib/islands';

const team = await getTeam();
---

<Layout
	title="Contact Us | EA Durham"
	description="Contact the Effective Altruism Durham committee members. Find roles, email addresses, and bios for our organizers."
>
	<SiteHeader />

	<main
		class="relative min-h-screen bg-cover bg-center bg-fixed bg-no-repeat"
		style="background-image: url('/assets/shared/page-hero-bg.jpg');"
	>
		<!-- Semi-transparent cream overlay to align with the EA brand theme and ensure readability -->
		<div class="absolute inset-0 bg-[#f4efe9]/85 backdrop-blur-[2px]"></div>

		<!-- Content container -->
		<div class="relative z-10 mx-auto w-full max-w-[980px] px-5 py-16 md:py-24">
			<!-- Page Title -->
			<div class="text-center mb-16">
				<h1
					class="font-ea-heading text-4xl md:text-5xl font-normal tracking-[0.25em] text-[#054d5a] uppercase mb-4"
				>
					Contact Us
				</h1>
				<div class="mx-auto h-[3px] w-24 bg-[#0c869b]"></div>
			</div>

			      <TinaIsland name="team" wrapper={islands.team.wrapper}>
        <Team data={team.data} showTitle={false} />
      </TinaIsland>
		</div>
	</main>

	<SiteFooter />
</Layout>
