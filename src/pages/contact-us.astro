---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import Team from "../components/Team.astro";
import { getTeam } from "../lib/team";
import { islands } from "../lib/islands";

const team = await getTeam();
---

<Layout
  title="Contact Us - Effective Altruism Durham"
  description="Contact the Effective Altruism Durham committee members. Find roles, email addresses, and bios for our organizers."
>
  <SiteHeader />
  
  <main class="w-full bg-white">
    <TinaIsland name="team" wrapper={islands.team.wrapper}>
      <Team data={team.data} />
    </TinaIsland>
  </main>
  
  <SiteFooter />
</Layout>
