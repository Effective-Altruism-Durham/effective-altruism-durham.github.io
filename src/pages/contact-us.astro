---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Team from '../components/Team.astro';
import PageFrame from '../components/PageFrame.astro';
import { getTeam } from '../lib/team';

const people = await getTeam();
---

<Layout
	title="Contact Us | EA Durham"
	description="Contact the Effective Altruism Durham committee members. Find roles, email addresses, and bios for our organizers."
>
	<SiteHeader />

	<PageFrame title="Contact Us" spaciousTitle>
		<div class="mx-auto w-full max-w-[1200px] px-6 pt-[52px] pb-24 sm:px-8 lg:px-0">
			<Team people={people} />
		</div>
	</PageFrame>

	<SiteFooter />
</Layout>
