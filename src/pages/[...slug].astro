---
import { useStoryblokApi } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { homepageDefaults } from "../data/homepageDefaults";

const { slug } = Astro.params;
const storySlug = slug || "home";
let story;

if (!import.meta.env.STORYBLOK_DELIVERY_API_TOKEN) {
  Astro.response.status = 404;
} else {
  try {
    const storyblokApi = useStoryblokApi();
    const { data } = await storyblokApi.get(`cdn/stories/${storySlug}`, {
      version: import.meta.env.DEV ? "draft" : "published",
    });

    story = data.story;
  } catch (error) {
    Astro.response.status = 404;
    console.warn(`Storyblok story unavailable for "${storySlug}".`, error);
  }
}

const storyContent = story?.content;
const title = storyContent?.meta_title || story?.name || homepageDefaults.title;
const description = storyContent?.meta_description || homepageDefaults.description;
---

<Layout title={title} description={description}>
  <SiteHeader />
  {storyContent ? (
    <StoryblokComponent blok={storyContent} />
  ) : (
    <main class="mx-auto max-w-[980px] px-5 py-20">
      <h1 class="font-ea-heading text-[40px] text-[#054d5a]">Page not found</h1>
    </main>
  )}
  <SiteFooter />
</Layout>
