---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CauseCard from "../components/CauseCard.astro";

const causes = [
  {
    title: "AI Safety",
    image: "/assets/causes/67772eaaa8174950975992b1e23d8c02.jpg",
    links: [
      { label: "Durham AI Safety", href: "https://durhamaisafety.uk/" }
    ]
  },
  {
    title: "Animal Advocacy",
    image: "/assets/causes/Cow.jpg",
    links: [
      { label: "Factory Farming", href: "https://80000hours.org/problem-profiles/factory-farming/" },
      { label: "Wild Animal Welfare", href: "https://80000hours.org/problem-profiles/wild-animal-welfare/" }
    ]
  },
  {
    title: "Biosecurity & Pandemics",
    image: "/assets/causes/Vaccine Production Line.jpg",
    links: [
      { label: "Learn More", href: "https://80000hours.org/problem-profiles/preventing-catastrophic-pandemics/" }
    ]
  },
  {
    title: "Global Health & Development",
    image: "/assets/causes/Favelas.jpeg",
    links: [
      { label: "Learn More", href: "https://www.effectivealtruism.org/articles/cause-profile-global-health-and-development" }
    ]
  },
  {
    title: "Future Generations",
    image: "/assets/causes/Love the Earth.jpeg",
    links: [
      { label: "Learn More", href: "https://www.effectivealtruism.org/articles/cause-profile-long-run-future" }
    ]
  },
  {
    title: "Government & Policy",
    image: "/assets/causes/Country Flags.jpg",
    links: [
      { label: "Learn More", href: "https://80000hours.org/career-reviews/policy-careers-focused-on-other-pressing-global-issues/" }
    ]
  },
  {
    title: "Nuclear Risk",
    image: "/assets/causes/Image by Yves Alarie.jpg",
    links: [
      { label: "Learn More", href: "https://80000hours.org/problem-profiles/nuclear-security/" }
    ]
  }
];
---

<Layout
  title="Cause Areas - Effective Altruism Durham"
  description="We focus our efforts on the world's most pressing and neglected problems: global health, biosecurity, AI safety, animal advocacy, future generations, and more."
>
  <SiteHeader />
  
  <main 
    class="relative min-h-screen bg-cover bg-center bg-fixed bg-no-repeat"
    style="background-image: url('/assets/shared/page-hero-bg.jpg');"
  >
    <!-- Semi-transparent cream overlay to align with the EA brand theme and ensure readability -->
    <div class="absolute inset-0 bg-[#f4efe9]/80 backdrop-blur-[1px]"></div>
    
    <!-- Content container -->
    <div class="relative z-10 mx-auto w-full max-w-[980px] px-5 py-16 md:py-24">
      
      <!-- Page Title -->
      <div class="text-center mb-12">
        <h1 class="font-ea-heading text-4xl md:text-5xl font-normal tracking-[0.25em] text-[#054d5a] uppercase mb-4">
          Cause Areas
        </h1>
        <div class="mx-auto h-[3px] w-24 bg-[#0c869b]"></div>
      </div>
      
      <!-- Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          causes.map((cause) => (
            <div class="h-full">
              <CauseCard
                title={cause.title}
                image={cause.image}
                links={cause.links}
              />
            </div>
          ))
        }
      </div>
      
    </div>
  </main>
  
  <SiteFooter />
</Layout>
