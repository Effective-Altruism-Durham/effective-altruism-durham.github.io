---
import { renderRichText, storyblokEditable } from "@storyblok/astro";
import { resolveStoryblokUrl } from "./storyblok-utils";

const { blok } = Astro.props;
const label = blok.label || "";
const textHtml = blok.text && typeof blok.text === "object" ? renderRichText(blok.text) : "";
const href = resolveStoryblokUrl(blok.link);
const linkLabel = blok.link_label || "Learn more";
---

<div {...storyblokEditable(blok)} class="text-center" style="color: #ffffff;">
  <h3
    class="mb-[18px] font-ea-body text-[14px] font-bold uppercase leading-normal"
    style="letter-spacing: 0.4em; color: #ffffff;"
  >
    {label.split("\n").map((line, i) => (
      <>
        {i > 0 && <br />}
        {line}
      </>
    ))}
  </h3>
  <hr class="mx-auto mb-[18px] h-[5px] w-[254px] border-0 border-t border-white" />
  {textHtml ? (
    <div class="font-ea-body text-[16px] leading-[1.4]" style="color: #ffffff;">
      <Fragment set:html={textHtml} />
    </div>
  ) : (
    <p class="font-ea-body text-[16px] leading-[1.4]" style="color: #ffffff;">
      {blok.text || ""}
    </p>
  )}
  {href && (
    <a
      href={href}
      target={href.startsWith("http") ? "_blank" : undefined}
      rel={href.startsWith("http") ? "noreferrer noopener" : undefined}
      class="mt-4 inline-block font-ea-body text-[14px] font-bold underline"
    >
      {linkLabel}
    </a>
  )}
</div>
