---
import { storyblokEditable } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";

const { blok, allowedComponents } = Astro.props;
const body = allowedComponents
  ? blok.body?.filter((nestedBlok) => allowedComponents.has(nestedBlok.component)) ?? []
  : blok.body ?? [];
---

<main {...storyblokEditable(blok)}>
  {body.map((nestedBlok) => <StoryblokComponent blok={nestedBlok} />)}
</main>
