---
import { renderRichText, storyblokEditable } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import ContactSection from "../components/ContactSection.astro";
import { homepageDefaults } from "../data/homepageDefaults";

import { normalizeAnchorId, resolveBackgroundClass } from "./storyblok-utils";

const { blok } = Astro.props;
const hasButtonsField = Array.isArray(blok.buttons);
const buttons = hasButtonsField ? blok.buttons : [];
const sectionId = normalizeAnchorId(blok.anchor_id);
const backgroundClass = blok.background_style ? resolveBackgroundClass(blok.background_style) : undefined;
---

<div {...storyblokEditable(blok)}>
  <ContactSection 
    heading={blok.heading || homepageDefaults.contact.heading}
    bodyHtml={blok.body ? renderRichText(blok.body) : undefined}
    firstNameLabel={blok.first_name_label}
    firstNamePlaceholder={blok.first_name_placeholder}
    lastNameLabel={blok.last_name_label}
    lastNamePlaceholder={blok.last_name_placeholder}
    emailLabel={blok.email_label}
    emailPlaceholder={blok.email_placeholder}
    subjectLabel={blok.subject_label}
    subjectPlaceholder={blok.subject_placeholder}
    messageLabel={blok.message_label}
    messagePlaceholder={blok.message_placeholder}
    submitLabel={blok.submit_label}
    sectionId={sectionId}
    backgroundClass={backgroundClass}
  >
    {hasButtonsField && (
      <Fragment slot="buttons">
        {buttons.map((button) => <StoryblokComponent blok={button} />)}
      </Fragment>
    )}
  </ContactSection>
</div>
