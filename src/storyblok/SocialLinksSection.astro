---
import { storyblokEditable } from "@storyblok/astro";
import SocialLinks from "../components/SocialLinks.astro";
import { homepageDefaults } from "../data/homepageDefaults";
import { normalizeAnchorId, resolveBackgroundClass, resolveStoryblokUrl } from "./storyblok-utils";

const { blok } = Astro.props;
const links = blok.links?.length
  ? blok.links.map((item) => ({
      label: item.label || "",
      url: resolveStoryblokUrl(item.link),
    }))
  : homepageDefaults.socialLinks;

const sectionId = normalizeAnchorId(blok.anchor_id);
const backgroundClass = resolveBackgroundClass(blok.background_style);
---

<div {...storyblokEditable(blok)}>
  <SocialLinks
    links={links}
    sectionId={sectionId}
    backgroundClass={backgroundClass}
  />
</div>
