---
import { storyblokEditable } from "@storyblok/astro";
import { resolveStoryblokUrl } from "./storyblok-utils";

const { blok } = Astro.props;
const href = resolveStoryblokUrl(blok.link);
const style = blok.style || "primary";

const className = style === "text"
  ? "inline-flex items-center justify-center text-[16px] font-bold underline text-black hover:text-[#541d58] transition-colors"
  : "group flex h-[70px] w-full items-center justify-center gap-3 rounded-[5px] px-6 text-center text-[16px] font-bold text-white transition-all duration-200";

const themeClasses = style === "secondary"
  ? "bg-[#054d5a] hover:bg-[#033943] active:scale-[0.98]"
  : "bg-[#68246d] hover:bg-[#541d58] active:scale-[0.98]";
---

{href && blok.label && (
  <a
    {...storyblokEditable(blok)}
    href={href}
    target={href.startsWith("http") ? "_blank" : undefined}
    rel={href.startsWith("http") ? "noreferrer noopener" : undefined}
    class:list={[className, style !== "text" && themeClasses]}
  >
    <span>{blok.label}</span>
    {style !== "text" && (
      <svg viewBox="0 0 60 60" class="h-4 w-4 fill-current transition-transform group-hover:translate-x-1" aria-hidden="true">
        <path d="M46.5 28.9L20.6 3c-.6-.6-1.6-.6-2.2 0l-4.8 4.8c-.6.6-.6 1.6 0 2.2l19.8 20-19.9 19.9c-.6.6-.6 1.6 0 2.2l4.8 4.8c.6.6 1.6.6 2.2 0l21-21 4.8-4.8c.8-.6.8-1.6.2-2.2z"></path>
      </svg>
    )}
  </a>
)}
