---
/**
 * WhatIsEA — "What is Effective Altruism?" section
 * Wix reference: section comp-loker22v
 *   - bg: brand dark teal
 *   - Heading: "What is / Effective Altruism?" at left:35px, Roboto Slab 40px, white
 *   - Description text at left:492px, width:407px, Raleway 18px, white
 *   - Video player at left:0px, 449x253, below heading
 *
 * The video is below the heading on the left, with the description to its right.
 */
---

<section
  id="what-is-ea"
  class="relative overflow-hidden bg-ea-dark-teal"
>
  <div 
    class="mx-auto w-full max-w-[980px] px-5 py-12 lg:py-0 lg:min-h-[525px] flex flex-col lg:grid lg:grid-cols-[554px_319px] lg:grid-rows-[auto_auto] lg:gap-x-[44px]"
  >
    <!-- Heading -->
    <div class="w-full lg:w-[441px] lg:col-start-1 lg:row-start-1 lg:ml-[74px] mt-4 lg:mt-[49px]">
        <h3 class="font-ea-heading text-[32px] md:text-[40px] leading-[1.4] font-normal text-white">
          What is<br />
          <span class="font-bold">Effective&nbsp;</span>Altruism?
        </h3>
    </div>

    <!-- Description (Stacks below the video on mobile/tablet, but at Row 2, Col 2 on Desktop) -->
    <div 
      class="font-ea-body text-[18px] leading-[1.4] text-white w-full lg:w-[319px] lg:col-start-2 lg:row-start-2 mt-8 lg:mt-[58px] order-3 lg:order-none"
    >
        <p>
          <a
            href="https://www.effectivealtruism.org/"
            target="_blank"
            rel="noreferrer noopener"
            class="text-white underline">Effective Altruism</a
          > is a framework for applying evidence-based reasoning to
          <a
            href="https://80000hours.org/problem-profiles/"
            target="_blank"
            rel="noreferrer noopener"
            class="text-white underline"
            >the world's most pressing problems</a
          >. It's also a practical community sharing diverse views on which
          problems to prioritise and how to tackle them.
        </p>
    </div>

    <!-- Video Frame (Stacks below heading on mobile/tablet, but at Row 2, Col 1 on Desktop) -->
    <div 
      class="w-full max-w-[480px] aspect-video lg:aspect-auto lg:w-[480px] lg:h-[270px] lg:col-start-1 lg:row-start-2 lg:ml-[74px] mt-6 lg:mt-[48px] order-2 lg:order-none"
    >
      <iframe
        class="h-full w-full rounded-lg lg:rounded-none"
        src="https://www.youtube-nocookie.com/embed/Diuv3XZQXyc?si=p6XQuSQe5CiJ9SsC"
        title="YouTube video player"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>
