---
/**
 * ContactSection — Contact form section
 * Wix reference: section comp-loker230
 *   - bg: color_43 = #054D5A
 *   - "Contact us" heading, Roboto Slab 20px, centered, cream (color_46 = #F4EFE9)
 *   - Form: first name, last name, email, subject, message, submit button
 */

import { homepageDefaults } from "../data/homepageDefaults";

const { 
  heading = homepageDefaults.contact.heading,
  bodyHtml,
  firstNameLabel = "First name",
  firstNamePlaceholder = "Will",
  lastNameLabel = "Last name",
  lastNamePlaceholder = "MacAskill",
  emailLabel = "Email",
  emailPlaceholder = "william@example.com",
  subjectLabel = "Subject",
  subjectPlaceholder = "Subject",
  messageLabel = "Message",
  messagePlaceholder = "Write your message here...",
  submitLabel = "Submit",
  sectionId = "contact-section",
  backgroundClass,
} = Astro.props;

const hasButtonsSlot = Astro.slots.has("buttons");
---

<section
  id={sectionId}
  class={`relative ${backgroundClass || ""}`}
  style={backgroundClass ? undefined : "background-color: #054d5a;"}
>
  <div class="mx-auto w-full max-w-[980px] px-5" style="padding-top: 19px; padding-bottom: 3px;">
    <h5
      class="mb-[10px] text-center font-ea-heading text-[20px] font-normal"
      style="color: #f4efe9;"
    >
      {heading}
    </h5>

    {bodyHtml && (
      <div class="mx-auto mb-6 max-w-[629px] text-center font-ea-body text-[16px] leading-[1.8] text-white">
        <Fragment set:html={bodyHtml} />
      </div>
    )}

    {hasButtonsSlot && (
      <div class="mx-auto mb-8 flex flex-col items-center justify-center gap-3 w-[268px]">
        <slot name="buttons" />
      </div>
    )}

    <div id="contact-success-message" class="hidden mx-auto max-w-[629px] text-center font-ea-body text-white p-8 rounded-[5px] border border-emerald-500/30 bg-emerald-950/40" style="margin-top: 20px; margin-bottom: 20px;">
      <svg class="mx-auto mb-4 h-12 w-12 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h4 class="text-xl font-bold mb-2">Thank You!</h4>
      <p>Your message has been sent successfully. We will get back to you as soon as possible.</p>
    </div>

    <div id="contact-error-message" class="hidden mx-auto mb-6 max-w-[629px] text-center font-ea-body text-[14px] text-red-200 p-4 rounded-[5px] border border-red-500/30 bg-red-950/40">
      <p>Something went wrong. Please check your connection and try again.</p>
    </div>

    <form
      class="mx-auto grid max-w-[797px] md:grid-cols-[304px_471px]"
      style="column-gap: 21px;"
      id="contact-form"
      name="contact"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      netlify
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden">
        <label>Don’t fill this out if you’re human: <input name="bot-field" /></label>
      </p>
      <div class="grid grid-cols-1">
        <div>
          <label
            for="first-name"
            class="mb-[9px] block font-ea-body text-[12px] text-white"
          >
            {firstNameLabel}
          </label>
          <input
            type="text"
            id="first-name"
            name="first-name"
            placeholder={firstNamePlaceholder}
            required
            class="h-8 w-full rounded-[5px] border-0 bg-white px-[7px] py-[3px] font-ea-body text-[16px] text-black outline-none"
          />
        </div>
        <div class="mt-[15px]">
          <label
            for="last-name"
            class="mb-[9px] block font-ea-body text-[12px] text-white"
          >
            {lastNameLabel}
          </label>
          <input
            type="text"
            id="last-name"
            name="last-name"
            placeholder={lastNamePlaceholder}
            required
            class="h-8 w-full rounded-[5px] border-0 bg-white px-[7px] py-[3px] font-ea-body text-[16px] text-black outline-none"
          />
        </div>

      <div class="mt-4">
        <label
          for="email"
          class="mb-[9px] block font-ea-body text-[12px] text-white"
        >
          {emailLabel}
        </label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder={emailPlaceholder}
          required
          class="h-[34px] w-full rounded-[5px] border-0 bg-white px-[7px] py-[3px] font-ea-body text-[16px] text-black outline-none"
        />
      </div>

      <div class="mt-4">
        <label
          for="subject"
          class="mb-[9px] block font-ea-body text-[12px] text-white"
        >
          {subjectLabel}
        </label>
        <input
          type="text"
          id="subject"
          name="subject"
          placeholder={subjectPlaceholder}
          required
          class="h-9 w-full rounded-[5px] border-0 bg-white px-[7px] py-[3px] font-ea-body text-[16px] text-black outline-none"
        />
      </div>
      </div>

      <div class="mt-[6px]">
        <label
          for="message"
          class="mb-[9px] block font-ea-body text-[12px] text-white"
        >
          {messageLabel}
        </label>
        <textarea
          id="message"
          name="message"
          placeholder={messagePlaceholder}
          required
          rows="8"
          class="h-[244px] w-full resize-none rounded-[5px] border-0 bg-white px-[7px] py-[3px] font-ea-body text-[12px] text-black outline-none"
        ></textarea>
      </div>

      <div class="mt-6 text-center md:col-span-2">
        <button
          type="submit"
          class="inline-block h-[53px] w-[304px] rounded-[5px] font-ea-body text-[18px] font-bold text-white transition-colors"
          style="background-color: #0c869b;"
          onmouseover="this.style.backgroundColor='#054d5a'"
          onmouseout="this.style.backgroundColor='#0c869b'"
        >
          {submitLabel}
        </button>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const successMessage = document.getElementById("contact-success-message");
  const errorMessage = document.getElementById("contact-error-message");
  const submitButton = form?.querySelector("button[type='submit']") as HTMLButtonElement | null;

  if (form && successMessage && errorMessage && submitButton) {
    const originalBtnText = submitButton.textContent;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Hide error message if previously shown
      errorMessage.classList.add("hidden");

      // Set submitting state
      submitButton.disabled = true;
      submitButton.textContent = "Sending...";
      const originalBg = submitButton.style.backgroundColor;
      submitButton.style.backgroundColor = "#054d5a";

      const formData = new FormData(form);
      const searchParams = new URLSearchParams();

      for (const [key, value] of formData.entries()) {
        searchParams.append(key, value as string);
      }

      try {
        const response = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: searchParams.toString(),
        });

        if (response.ok) {
          // Hide form and show success message
          form.classList.add("hidden");
          successMessage.classList.remove("hidden");
          successMessage.scrollIntoView({ behavior: "smooth", block: "center" });
        } else {
          throw new Error("Failed to submit form");
        }
      } catch (err) {
        console.error(err);
        errorMessage.classList.remove("hidden");
        submitButton.disabled = false;
        if (originalBtnText) submitButton.textContent = originalBtnText;
        submitButton.style.backgroundColor = originalBg;
      }
    });
  }
</script>
