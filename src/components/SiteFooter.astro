---
import BrandButton from './BrandButton.astro';

/**
 * SiteFooter — Footer bar with Newsletter sign-up, DSU disclaimer and Social Links
 * Wix reference: SITE_FOOTER
 *   - bg: brand dark teal
 *   - Grid layout: Left has mailing list button and DSU disclaimer; Right has vertical socials stack
 */
---

<footer
  id="site-footer"
  class="relative bg-ea-dark-teal py-12"
>
  <div class="mx-auto w-full max-w-[980px] px-5">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-[1fr_auto] md:gap-16">
      
      <!-- Left Column: Newsletter CTA & Disclaimer -->
      <div class="flex flex-col items-center md:items-start gap-6">
        <!-- Join the mailing list button (copied from HeroSection) -->
        <BrandButton
          href="https://outlook.office365.com/owa/effectivealtruismdurham@durhamuniversity.onmicrosoft.com/groupsubscription.ashx?action=join&source=MSExchange/LokiServer&guid=e5909571-b397-42c5-99bc-b362c640ca29"
          external
          class="h-[70px] w-full max-w-[268px] px-6 text-[16px]"
        >
          <span>Join the mailing list</span>
          <svg viewBox="0 0 60 60" class="h-4 w-4 fill-current" aria-hidden="true">
            <path d="M46.5 28.9L20.6 3c-.6-.6-1.6-.6-2.2 0l-4.8 4.8c-.6.6-.6 1.6 0 2.2l19.8 20-19.9 19.9c-.6.6-.6 1.6 0 2.2l4.8 4.8c.6.6 1.6.6 2.2 0l21-21 4.8-4.8c.8-.6.8-1.6.2-2.2z"></path>
          </svg>
        </BrandButton>

        <!-- Disclaimer -->
        <p class="font-ea-body text-[14px] leading-normal text-white text-center md:text-left">
          Effective Altruism Durham is a student group affiliated with Durham Students' Union (also known as Durham SU or DSU), 
          which is registered in England as a company limited by guarantee (07689815) and a charity (1145400). 
          DSU's registered office is Dunelm House, New Elvet, Durham, DH1 3AN.
          Effective Altruism Durham follows Durham Students' Union's privacy policy and code of conduct.
        </p>
      </div>

      <!-- Right Column: Vertical Socials Stack with handles/addresses -->
      <div class="flex flex-col gap-4 items-center md:items-start justify-center">
        <span class="font-ea-body font-bold text-white text-[16px]">
          Contact Us
        </span>
        <!-- Instagram -->
        <a
          href="https://www.instagram.com/effectivealtruismdurham/"
          target="_blank"
          rel="noreferrer noopener"
          aria-label="Instagram"
          class="flex items-center gap-3 font-ea-body text-[14px] text-white hover:opacity-70 transition-opacity"
        >
          <svg viewBox="0 0 24 24" class="h-6 w-6 fill-current flex-shrink-0">
            <path
              d="M12 2.162c3.204 0 3.584.012 4.849.07 1.308.06 2.655.358 3.608 1.311.962.962 1.251 2.296 1.311 3.608.058 1.265.07 1.645.07 4.849s-.012 3.584-.07 4.849c-.059 1.301-.364 2.661-1.311 3.608-.962.962-2.295 1.251-3.608 1.311-1.265.058-1.645.07-4.849.07s-3.584-.012-4.849-.07c-1.291-.059-2.669-.371-3.608-1.311-.957-.957-1.251-2.304-1.311-3.608-.058-1.265-.07-1.645-.07-4.849s.012-3.584.07-4.849c.059-1.296.367-2.664 1.311-3.608.96-.96 2.299-1.251 3.608-1.311 1.265-.058 1.645-.07 4.849-.07M12 0C8.741 0 8.332.014 7.052.072 5.197.157 3.355.673 2.014 2.014.668 3.36.157 5.198.072 7.052.014 8.332 0 8.741 0 12s.014 3.668.072 4.948c.085 1.853.603 3.7 1.942 5.038 1.345 1.345 3.186 1.857 5.038 1.942C8.332 23.986 8.741 24 12 24s3.668-.014 4.948-.072c1.854-.085 3.698-.602 5.038-1.942 1.347-1.347 1.857-3.184 1.942-5.038.058-1.28.072-1.689.072-4.948s-.014-3.668-.072-4.948c-.085-1.855-.602-3.698-1.942-5.038C20.643.671 18.797.156 16.948.072 15.668.014 15.259 0 12 0"
            ></path>
            <path
              d="M12 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8"
            ></path>
            <path
              d="M19.846 5.594a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0"
            ></path>
          </svg>
          <span>@effectivealtruismdurham</span>
        </a>

        <!-- Email -->
        <a
          href="mailto:effective.altruism@durham.ac.uk"
          aria-label="Email"
          class="flex items-center gap-3 font-ea-body text-[14px] text-white hover:opacity-70 transition-opacity"
        >
          <svg viewBox="0 1 24 22" class="h-6 w-[26px] fill-current flex-shrink-0">
            <path
              d="M19 1H5a5.006 5.006 0 0 0-5 5v12a5.006 5.006 0 0 0 5 5h14a5.006 5.006 0 0 0 5-5V6a5.006 5.006 0 0 0-5-5M5 3h14a3 3 0 0 1 2.78 1.887l-7.658 7.659a3.007 3.007 0 0 1-4.244 0L2.22 4.887A3 3 0 0 1 5 3m14 18H5a3 3 0 0 1-3-3V7.5l6.464 6.46a5.007 5.007 0 0 0 7.072 0L22 7.5V18a3 3 0 0 1-3 3"
            ></path>
          </svg>
          <span>effective.altruism@durham.ac.uk</span>
        </a>

        <!-- Facebook -->
        <a
          href="https://www.facebook.com/EffectiveAltruismDurham"
          target="_blank"
          rel="noreferrer noopener"
          aria-label="Facebook"
          class="flex items-center gap-3 font-ea-body text-[14px] text-white hover:opacity-70 transition-opacity"
        >
          <svg viewBox="0 0.073 24 23.855" class="h-6 w-6 fill-current flex-shrink-0">
            <path
              d="M24 12.073c0 5.989-4.394 10.954-10.13 11.855v-8.363h2.789l.531-3.46h-3.32V9.86c0-.947.464-1.869 1.95-1.869h1.509V5.045s-1.37-.234-2.679-.234c-2.734 0-4.52 1.657-4.52 4.656v2.637H7.091v3.46h3.039v8.363C4.395 23.025 0 18.061 0 12.073c0-6.627 5.373-12 12-12s12 5.372 12 12"
            ></path>
          </svg>
          <span>EffectiveAltruismDurham</span>
        </a>
      </div>

    </div>
  </div>
</footer>
