---
import BrandButton from './BrandButton.astro';

/**
 * AreteFellowship — Arete Fellowship call-out section
 * Wix reference: section comp-m6gxpfqv
 *   - bg: brand cream
 *   - Heading: "Arete Fellowship" in 56px, centered, brand dark teal
 *   - Description: Raleway 16px, 1.8em line-height, centered, black
 *   - Button: purple "Learn more" with chevron
 */
---

<section
  id="arete-fellowship"
  class="relative bg-ea-cream"
>
  <div class="mx-auto w-full max-w-[980px] px-5 text-center py-16 md:py-0 md:min-h-[440px] md:pt-[87px]">
    <h2
      class="mb-[30px] font-ea-heading text-[36px] sm:text-[56px] font-normal leading-[1.4] text-ea-dark-teal"
    >
      Arete Fellowship
    </h2>
    <p
      class="mx-auto mb-[40px] max-w-[629px] font-ea-body text-[16px] leading-[1.8] text-black"
    >
      An 8-week seminar programme aimed to introduce you to ideas from various
      disciplines for making a positive impact on the world.
    </p>
    <BrandButton
      href="/arete-fellowship"
      class="h-[54px] w-[268px] px-7 text-[16px]"
    >
      <span>Learn more</span>
      <svg
        viewBox="0 0 60 60"
        class="h-4 w-4 fill-current"
        aria-hidden="true"
      >
        <path
          d="M46.5 28.9L20.6 3c-.6-.6-1.6-.6-2.2 0l-4.8 4.8c-.6.6-.6 1.6 0 2.2l19.8 20-19.9 19.9c-.6.6-.6 1.6 0 2.2l4.8 4.8c.6.6 1.6.6 2.2 0l21-21 4.8-4.8c.8-.6.8-1.6.2-2.2z"
        ></path>
      </svg>
    </BrandButton>
  </div>
</section>
