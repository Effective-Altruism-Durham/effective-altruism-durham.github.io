---
/**
 * AreteFellowship — Arete Fellowship call-out section
 * Wix reference: section comp-m6gxpfqv
 *   - bg: color_42 = rgb(244,239,233) = #F4EFE9 (cream)
 *   - Heading: "Arete Fellowship" in 56px, centered, color_43 = #054D5A
 *   - Description: Raleway 16px, 1.8em line-height, centered, black
 *   - Button: purple "Learn more" with chevron
 */

import { homepageDefaults } from "../data/homepageDefaults";

const {
  heading = homepageDefaults.arete.heading,
  body = homepageDefaults.arete.body,
  bodyHtml,
  ctaLabel = homepageDefaults.arete.ctaLabel,
  ctaUrl = homepageDefaults.arete.ctaUrl,
} = Astro.props;

const hasButtonsSlot = Astro.slots.has("buttons");
---

<section
  id="arete-fellowship"
  class="relative"
  style="background-color: #f4efe9;"
>
  <div class="mx-auto w-full max-w-[980px] px-5 text-center" style="min-height: 440px; padding-top: 87px;">
    <h2
      class="mb-[30px] font-ea-heading text-[56px] font-normal leading-[1.4]"
      style="color: #054d5a;"
    >
      {heading}
    </h2>
    {bodyHtml ? (
      <div class="mx-auto mb-[40px] max-w-[629px] font-ea-body text-[16px] leading-[1.8] text-black">
        <Fragment set:html={bodyHtml} />
      </div>
    ) : (
      <p
        class="mx-auto mb-[40px] max-w-[629px] font-ea-body text-[16px] leading-[1.8] text-black"
      >
        {body}
      </p>
    )}
    
    {hasButtonsSlot ? (
      <div class="mx-auto flex flex-col items-center justify-center gap-3 w-[268px]">
        <slot name="buttons" />
      </div>
    ) : (
      <a
        href={ctaUrl}
        class="group inline-flex h-[54px] w-[268px] items-center justify-center gap-3 rounded-[5px] px-7 text-[16px] font-bold text-white transition-colors"
        style="background-color: #68246d;"
        onmouseover="this.style.backgroundColor='#541d58'"
        onmouseout="this.style.backgroundColor='#68246d'"
      >
        <span>{ctaLabel}</span>
        <svg
          viewBox="0 0 60 60"
          class="h-4 w-4 fill-current"
          aria-hidden="true"
        >
          <path
            d="M46.5 28.9L20.6 3c-.6-.6-1.6-.6-2.2 0l-4.8 4.8c-.6.6-.6 1.6 0 2.2l19.8 20-19.9 19.9c-.6.6-.6 1.6 0 2.2l4.8 4.8c.6.6 1.6.6 2.2 0l21-21 4.8-4.8c.8-.6.8-1.6.2-2.2z"
          ></path>
        </svg>
      </a>
    )}
  </div>
</section>
