---
/**
 * SiteHeader — sticky teal header with logo, title, nav, and V-wave divider.
 * Matches the Wix reference site exactly:
 *   - bg: brand active teal
 *   - 980px content area, logo 100x100 at left:35px, title at left:156px
 *   - Nav: Raleway 700 15px uppercase white
 *   - V-wave SVG hangs below header into the hero section
 */

interface NavItem {
	label: string;
	href: string;
	children?: { label: string; href: string }[];
}

const navItems: NavItem[] = [
	{
		label: 'PROGRAMMES',
		href: '/programmes',
		children: [
			{ label: 'Arete Fellowship', href: '/arete-fellowship' },
			{ label: 'IDEA Fellowship', href: '/idea-fellowship' },
		],
	},
	{
		label: 'OPPORTUNITIES',
		href: '/opportunities',
	},
	{
		label: 'CAUSES',
		href: '/causes',
	},
	{ label: 'EVENTS', href: '/events' },
	{ label: 'CONTACT US', href: '/contact-us' },
];
---

<header id="site-header" class="sticky top-0 z-50 w-full bg-ea-active-teal">
	<div class="relative">
		<!-- Content area: 980px centered -->
		<div class="mx-auto w-full max-w-[980px] px-5">
			<!-- Logo row -->
			<div class="flex items-center gap-5 pt-5 pb-3">
				<!-- Logo circle -->
				<a href="/" class="flex-shrink-0" aria-label="EA Durham Home">
					<img src="/favicon.svg" alt="EA Durham" class="h-[100px] w-[100px]" />
				</a>

				<!-- Title + Nav stacked vertically -->
				<div class="flex min-w-0 flex-1 flex-col gap-2">
					<!-- Title -->
					<a href="/" class="block text-white">
						<h1
							class="font-ea-heading text-[30px] leading-tight"
							style="font-weight: normal;"
						>
							<span class="font-bold">Effective</span> Altruism Durham
						</h1>
					</a>

					<!-- Navigation -->
					<nav aria-label="Site" class="hidden md:block">
						<ul class="flex items-center gap-5">
							{
								navItems.map((item) => (
									<li class="group relative">
										<a
											href={item.href}
											class="inline-block py-1 text-[15px] font-bold leading-[30px] tracking-[0.05em] text-white transition-opacity hover:opacity-80"
										>
											{item.label}
										</a>
										{item.children && (
											<ul class="invisible absolute left-0 top-full z-[99999] min-w-[280px] rounded-[5px] bg-ea-active-teal p-4 pt-3 opacity-0 shadow-lg transition-all group-hover:visible group-hover:opacity-100">
												{item.children.map((child) => (
													<li>
														<a
															href={child.href}
															target={
																child.href.startsWith('http')
																	? '_blank'
																	: undefined
															}
															rel={
																child.href.startsWith('http')
																	? 'noreferrer noopener'
																	: undefined
															}
															class="block border-t border-white/20 px-2 py-2 text-sm text-white transition-opacity first:border-0 hover:opacity-80"
														>
															{child.label}
														</a>
													</li>
												))}
											</ul>
										)}
									</li>
								))
							}
							<!-- Separator -->
							<li class="h-4 w-px bg-white/30 mx-1" aria-hidden="true"></li>
							<!-- Social Links -->
							<li class="flex items-center gap-3">
								<a
									href="https://www.instagram.com/effectivealtruismdurham/"
									target="_blank"
									rel="noreferrer noopener"
									aria-label="Instagram"
									class="text-white hover:opacity-75 transition-opacity"
								>
									<svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
										<path d="M12 2.162c3.204 0 3.584.012 4.849.07 1.308.06 2.655.358 3.608 1.311.962.962 1.251 2.296 1.311 3.608.058 1.265.07 1.645.07 4.849s-.012 3.584-.07 4.849c-.059 1.301-.364 2.661-1.311 3.608-.962.962-2.295 1.251-3.608 1.311-1.265.058-1.645.07-4.849.07s-3.584-.012-4.849-.07c-1.291-.059-2.669-.371-3.608-1.311-.957-.957-1.251-2.304-1.311-3.608-.058-1.265-.07-1.645-.07-4.849s.012-3.584.07-4.849c.059-1.296.367-2.664 1.311-3.608.96-.96 2.299-1.251 3.608-1.311 1.265-.058 1.645-.07 4.849-.07M12 0C8.741 0 8.332.014 7.052.072 5.197.157 3.355.673 2.014 2.014.668 3.36.157 5.198.072 7.052.014 8.332 0 8.741 0 12s.014 3.668.072 4.948c.085 1.853.603 3.7 1.942 5.038 1.345 1.345 3.186 1.857 5.038 1.942C8.332 23.986 8.741 24 12 24s3.668-.014 4.948-.072c1.854-.085 3.698-.602 5.038-1.942 1.347-1.347 1.857-3.184 1.942-5.038.058-1.28.072-1.689.072-4.948s-.014-3.668-.072-4.948c-.085-1.855-.602-3.698-1.942-5.038C20.643.671 18.797.156 16.948.072 15.668.014 15.259 0 12 0"></path>
										<path d="M12 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8"></path>
										<path d="M19.846 5.594a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0"></path>
									</svg>
								</a>
								<a
									href="mailto:effective.altruism@durham.ac.uk"
									aria-label="Email"
									class="text-white hover:opacity-75 transition-opacity"
								>
									<svg viewBox="0 1 24 22" class="h-5 w-[22px] fill-current">
										<path d="M19 1H5a5.006 5.006 0 0 0-5 5v12a5.006 5.006 0 0 0 5 5h14a5.006 5.006 0 0 0 5-5V6a5.006 5.006 0 0 0-5-5M5 3h14a3 3 0 0 1 2.78 1.887l-7.658 7.659a3.007 3.007 0 0 1-4.244 0L2.22 4.887A3 3 0 0 1 5 3m14 18H5a3 3 0 0 1-3-3V7.5l6.464 6.46a5.007 5.007 0 0 0 7.072 0L22 7.5V18a3 3 0 0 1-3 3"></path>
									</svg>
								</a>
								<a
									href="https://www.facebook.com/EffectiveAltruismDurham"
									target="_blank"
									rel="noreferrer noopener"
									aria-label="Facebook"
									class="text-white hover:opacity-75 transition-opacity"
								>
									<svg viewBox="0 0 24 23.855" class="h-5 w-5 fill-current">
										<path d="M24 12.073c0 5.989-4.394 10.954-10.13 11.855v-8.363h2.789l.531-3.46h-3.32V9.86c0-.947.464-1.869 1.95-1.869h1.509V5.045s-1.37-.234-2.679-.234c-2.734 0-4.52 1.657-4.52 4.656v2.637H7.091v3.46h3.039v8.363C4.395 23.025 0 18.061 0 12.073c0-6.627 5.373-12 12-12s12 5.372 12 12"></path>
									</svg>
								</a>
							</li>
						</ul>
					</nav>
				</div>

				<!-- Mobile Burger Button -->
				<button
					id="mobile-menu-toggle"
					class="relative z-50 flex h-12 w-12 cursor-pointer flex-col items-center justify-center gap-1.5 rounded-[5px] text-white transition-all duration-500 hover:bg-white/10 md:hidden focus:outline-none"
					aria-label="Toggle navigation menu"
				>
					<span class="block h-[2.5px] w-7 bg-white transition-all duration-300 origin-center line-1"></span>
					<span class="block h-[2.5px] w-7 bg-white transition-all duration-300 line-2"></span>
					<span class="block h-[2.5px] w-7 bg-white transition-all duration-300 origin-center line-3"></span>
				</button>
			</div>
		</div>

		<!-- Full-screen Mobile Menu Overlay -->
		<div
			id="mobile-menu"
			class="fixed inset-x-0 top-0 z-40 h-screen w-full -translate-y-full bg-ea-active-teal px-8 pt-[140px] pb-10 transition-transform duration-500 ease-in-out md:hidden overflow-y-auto flex flex-col justify-between"
		>
			<nav aria-label="Mobile site" class="w-full">
				<ul class="flex flex-col gap-6 text-center">
					{
						navItems.map((item) => (
							<li class="border-b border-white/10 pb-4">
								<a
									href={item.href}
									class="block text-2xl font-bold tracking-[0.05em] text-white hover:text-white/80 active:scale-95 transition-all"
								>
									{item.label}
								</a>
								{item.children && (
									<ul class="mt-3 flex flex-col gap-3">
										{item.children.map((child) => (
											<li>
												<a
													href={child.href}
													target={
														child.href.startsWith('http')
															? '_blank'
															: undefined
													}
													rel={
														child.href.startsWith('http')
															? 'noreferrer noopener'
															: undefined
													}
													class="block text-[16px] text-white/95 hover:text-white active:scale-95 transition-all"
												>
													{child.label}
												</a>
											</li>
										))}
									</ul>
								)}
							</li>
						))
					}
				</ul>
			</nav>

			<!-- Mobile Social Links at bottom -->
			<div class="border-t border-white/20 pt-6 mt-8 flex flex-col items-center gap-4">
				<p class="text-white/60 text-xs tracking-widest uppercase font-bold">Connect with us</p>
				<div class="flex items-center gap-8">
					<a
						href="https://www.instagram.com/effectivealtruismdurham/"
						target="_blank"
						rel="noreferrer noopener"
						aria-label="Instagram"
						class="text-white hover:scale-110 active:scale-95 transition-all"
					>
						<svg viewBox="0 0 24 24" class="h-7 w-7 fill-current">
							<path d="M12 2.162c3.204 0 3.584.012 4.849.07 1.308.06 2.655.358 3.608 1.311.962.962 1.251 2.296 1.311 3.608.058 1.265.07 1.645.07 4.849s-.012 3.584-.07 4.849c-.059 1.301-.364 2.661-1.311 3.608-.962.962-2.295 1.251-3.608 1.311-1.265.058-1.645.07-4.849.07s-3.584-.012-4.849-.07c-1.291-.059-2.669-.371-3.608-1.311-.957-.957-1.251-2.304-1.311-3.608-.058-1.265-.07-1.645-.07-4.849s.012-3.584.07-4.849c.059-1.296.367-2.664 1.311-3.608.96-.96 2.299-1.251 3.608-1.311 1.265-.058 1.645-.07 4.849-.07M12 0C8.741 0 8.332.014 7.052.072 5.197.157 3.355.673 2.014 2.014.668 3.36.157 5.198.072 7.052.014 8.332 0 8.741 0 12s.014 3.668.072 4.948c.085 1.853.603 3.7 1.942 5.038 1.345 1.345 3.186 1.857 5.038 1.942C8.332 23.986 8.741 24 12 24s3.668-.014 4.948-.072c1.854-.085 3.698-.602 5.038-1.942 1.347-1.347 1.857-3.184 1.942-5.038.058-1.28.072-1.689.072-4.948s-.014-3.668-.072-4.948c-.085-1.855-.602-3.698-1.942-5.038C20.643.671 18.797.156 16.948.072 15.668.014 15.259 0 12 0"></path>
							<path d="M12 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8"></path>
							<path d="M19.846 5.594a1.44 1.44 0 1 1-2.88 0 1.44 1.44 0 0 1 2.88 0"></path>
						</svg>
					</a>
					<a
						href="mailto:effective.altruism@durham.ac.uk"
						aria-label="Email"
						class="text-white hover:scale-110 active:scale-95 transition-all"
					>
						<svg viewBox="0 1 24 22" class="h-7 w-[30px] fill-current">
							<path d="M19 1H5a5.006 5.006 0 0 0-5 5v12a5.006 5.006 0 0 0 5 5h14a5.006 5.006 0 0 0 5-5V6a5.006 5.006 0 0 0-5-5M5 3h14a3 3 0 0 1 2.78 1.887l-7.658 7.659a3.007 3.007 0 0 1-4.244 0L2.22 4.887A3 3 0 0 1 5 3m14 18H5a3 3 0 0 1-3-3V7.5l6.464 6.46a5.007 5.007 0 0 0 7.072 0L22 7.5V18a3 3 0 0 1-3 3"></path>
						</svg>
					</a>
					<a
						href="https://www.facebook.com/EffectiveAltruismDurham"
						target="_blank"
						rel="noreferrer noopener"
						aria-label="Facebook"
						class="text-white hover:scale-110 active:scale-95 transition-all"
					>
						<svg viewBox="0 0 24 23.855" class="h-7 w-7 fill-current">
							<path d="M24 12.073c0 5.989-4.394 10.954-10.13 11.855v-8.363h2.789l.531-3.46h-3.32V9.86c0-.947.464-1.869 1.95-1.869h1.509V5.045s-1.37-.234-2.679-.234c-2.734 0-4.52 1.657-4.52 4.656v2.637H7.091v3.46h3.039v8.363C4.395 23.025 0 18.061 0 12.073c0-6.627 5.373-12 12-12s12 5.372 12 12"></path>
						</svg>
					</a>
				</div>
			</div>
		</div>
			</div>
		</div>
	</div>
</header>

<style>
	/* Custom burger animations */
	#mobile-menu-toggle {
		transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}
	#mobile-menu-toggle span {
		transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.4s ease, width 0.4s ease;
	}
	#mobile-menu-toggle.open {
		transform: rotate(360deg);
	}
	#mobile-menu-toggle.open .line-1 {
		transform: translateY(8.5px) rotate(45deg);
	}
	#mobile-menu-toggle.open .line-2 {
		opacity: 0;
		transform: scaleX(0);
	}
	#mobile-menu-toggle.open .line-3 {
		transform: translateY(-8.5px) rotate(-45deg);
	}
</style>

<script>
	const toggleBtn = document.getElementById('mobile-menu-toggle');
	const mobileMenu = document.getElementById('mobile-menu');

	if (toggleBtn && mobileMenu) {
		const toggleMenu = () => {
			const isOpen = toggleBtn.classList.contains('open');
			if (isOpen) {
				toggleBtn.classList.remove('open');
				mobileMenu.classList.add('-translate-y-full');
				document.body.classList.remove('overflow-hidden');
			} else {
				toggleBtn.classList.add('open');
				mobileMenu.classList.remove('-translate-y-full');
				document.body.classList.add('overflow-hidden');
			}
		};

		toggleBtn.addEventListener('click', toggleMenu);

		// Close menu when clicking on links
		const menuLinks = mobileMenu.querySelectorAll('a');
		menuLinks.forEach((link) => {
			link.addEventListener('click', () => {
				toggleBtn.classList.remove('open');
				mobileMenu.classList.add('-translate-y-full');
				document.body.classList.remove('overflow-hidden');
			});
		});
	}
</script>
