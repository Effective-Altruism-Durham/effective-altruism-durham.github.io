---
import { getImage } from "astro:assets";
import heroBg from "../assets/shared/page-hero-bg.jpg";

interface Props {
  title: string;
  overlay?: "default" | "soft";
  spaciousTitle?: boolean;
}

const { title, overlay = "default", spaciousTitle = false } = Astro.props;
const hasIntro = Astro.slots.has("intro");

// The 2940px source JPEG is ~1 MB. It sits under an 80-85% cream overlay with a blur, so a
// 1920px quality-50 WebP (~190 kB) screenshots pixel-identical to the original.
const background = await getImage({ src: heroBg, width: 1920, format: "webp", quality: 50 });
---

<main class="ea-page-shell" style={`--ea-page-hero-image: url("${background.src}")`}>
  <div class:list={[overlay === "soft" ? "ea-page-overlay-soft" : "ea-page-overlay"]}></div>

  <div class="ea-page-container">
    <div class:list={[spaciousTitle ? "ea-page-heading-wrap-spacious" : "ea-page-heading-wrap"]}>
      <h1 class="ea-page-title">{title}</h1>
      <div class:list={["ea-title-rule", hasIntro && "mb-6"]}></div>
      {hasIntro && (
        <div class="ea-copy mx-auto max-w-[800px] text-base md:text-lg">
          <slot name="intro" />
        </div>
      )}
    </div>

    <slot />
  </div>
</main>
