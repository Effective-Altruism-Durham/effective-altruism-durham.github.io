---
interface Props {
  title: string;
  href: string;
  items: { label: string; href: string }[];
}

const { title, href, items } = Astro.props;
---

<div class="relative group h-full flex items-center">
  <a
    href={href}
    class="flex items-center gap-1.5 px-4 py-2 text-[13px] font-semibold tracking-widest text-ea-text-secondary hover:text-ea-active-teal focus:text-ea-active-teal transition-all duration-300 uppercase font-ea-body outline-none"
  >
    {title}
    <svg
      class="w-3 h-3 transition-transform duration-300 ease-out group-hover:rotate-180 text-ea-text-secondary/60 group-hover:text-ea-active-teal"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="3"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </a>

  <!-- Dropdown Menu container with perfect positioning, hover/focus states, and animations -->
  <div
    class="absolute left-1/2 -translate-x-1/2 top-full w-64 bg-white/95 backdrop-blur-md border border-ea-dark-teal/10 rounded-xl shadow-xl opacity-0 translate-y-2 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-300 ease-out z-50"
  >
    <!-- Little arrow bubble top pointer -->
    <div class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3 h-3 rotate-45 bg-white border-t border-l border-ea-dark-teal/10"></div>
    
    <div class="relative py-2.5 z-10">
      {
        items.map((item) => (
          <a
            href={item.href}
            class="block px-5 py-3 text-sm text-ea-text-secondary hover:text-ea-active-teal hover:bg-ea-beige/35 transition-all duration-200 font-medium font-ea-body"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</div>
