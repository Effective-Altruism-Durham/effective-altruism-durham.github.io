---
import PersonCard from "./PersonCard.astro";
import type { TeamData } from "../lib/team";

interface Props {
  data: TeamData;
  showTitle?: boolean;
}

const { data, showTitle = true } = Astro.props;
---

{showTitle && (
  <h1 class="mb-[54px] text-center font-ea-heading text-[44px] font-normal leading-none text-[#054d5a] sm:text-[56px]">
    {data.title}
  </h1>
)}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 justify-center items-stretch">
  {data.people.map((person) => (
    <div class="h-full">
      <PersonCard person={person} />
    </div>
  ))}
</div>
