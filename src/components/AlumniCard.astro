---
import { Image } from 'astro:assets';
import { resolveCmsImage } from '../lib/cms-images';
import type { TeamMember } from '../lib/team';

interface Props {
	person: TeamMember;
}

const { person } = Astro.props;

const image = resolveCmsImage(person.image);
const imageClass = 'h-20 w-20 rounded-full border-2 border-ea-border bg-white object-cover';

// Editors often paste "linkedin.com/in/..." without a scheme; anything that isn't a web
// address (e.g. "javascript:") is dropped rather than linked.
const link = person.link?.trim();
const href = !link
	? undefined
	: /^https?:\/\//i.test(link)
		? link
		: /^[a-z][a-z0-9+.-]*:/i.test(link)
			? undefined
			: `https://${link}`;
---

<article
	class="flex flex-col items-center bg-white/95 border border-ea-border rounded-2xl p-5 text-center h-full"
>
	{typeof image === 'string' ? (
		<img
			src={image}
			alt={person.name}
			class={imageClass}
			width="80"
			height="80"
			loading="lazy"
		/>
	) : (
		<Image
			src={image}
			alt={person.name}
			class={imageClass}
			width={80}
			height={80}
			densities={[1, 2]}
		/>
	)}

	<h3 class="mt-3 font-ea-heading text-lg font-bold leading-tight text-ea-dark-teal">
		{person.name}
	</h3>

	<p class="mt-1 font-ea-body text-xs font-semibold text-ea-text-secondary">
		{person.roles}{person.years && <span class="font-normal"> · {person.years}</span>}
	</p>

	{person.now && (
		<p class="mt-2 font-ea-body text-sm text-ea-text-secondary/90 italic">Now: {person.now}</p>
	)}

	{href && (
		<a
			href={href}
			class="mt-2 font-ea-body text-xs font-semibold text-ea-active-teal underline hover:text-ea-dark-teal"
			target="_blank"
			rel="noopener noreferrer"
			data-astro-prefetch="false"
		>
			Profile
		</a>
	)}
</article>
