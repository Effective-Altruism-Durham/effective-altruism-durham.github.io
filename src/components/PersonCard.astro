---
import { Image } from 'astro:assets';
import { resolveCmsImage } from '../lib/cms-images';
import type { TeamMember } from '../lib/team';

interface Props {
	person: TeamMember;
}

const { person } = Astro.props;

const image = resolveCmsImage(person.image);
const imageClass =
	'h-28 w-28 md:h-32 md:w-32 rounded-full border-4 border-ea-border group-hover:border-ea-active-teal/70 bg-white object-cover transition-colors duration-300 relative z-10';

// Split roles by comma to display as sleek badges
const roleList = person.roles
	? person.roles.split(',').map((role) => role.trim())
	: [];
---

<article
	class="flex flex-col items-center bg-white/95 border border-ea-border rounded-2xl p-8 shadow-sm hover:shadow-xl hover:border-ea-active-teal/40 hover:-translate-y-1 transition-all duration-300 group h-full relative"
>
	<!-- Portrait Image (Double circular borders with group-hover transition) -->
	<div class="mb-6 flex-shrink-0 relative">
		<div
			class="absolute inset-[-6px] rounded-full border border-ea-active-teal/25 scale-100 group-hover:scale-[1.08] transition-transform duration-300"
		>
		</div>
		{typeof image === 'string' ? (
			<img
				src={image}
				alt={person.name}
				class={imageClass}
				width="128"
				height="128"
				loading="lazy"
			/>
		) : (
			<Image
				src={image}
				alt={person.name}
				class={imageClass}
				width={128}
				height={128}
				densities={[1, 2]}
			/>
		)}
	</div>

	<!-- Content Details -->
	<div class="flex-grow flex flex-col items-center text-center w-full min-w-0">
		<!-- Name -->
		<h3
			class="mb-3 font-ea-heading text-xl md:text-2xl font-bold leading-tight text-ea-dark-teal tracking-wide"
		>
			{person.name}
		</h3>

		<!-- Roles Badges -->
		<div
			class="mb-4 flex flex-wrap gap-2 justify-center"
		>
			{
				roleList.map((role) => (
					<span class="inline-block px-3 py-1 bg-ea-cream text-ea-dark-teal font-ea-body text-xs font-semibold rounded-full border border-ea-border/80 tracking-wide">
						{role}
					</span>
				))
			}
		</div>

		<!-- Email Button -->
		<div class="mb-5 flex items-center justify-center">
			<a
				href={`mailto:${person.email}`}
				class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-lg bg-ea-active-teal text-white font-ea-body text-sm font-semibold transition-all duration-300 hover:bg-ea-dark-teal hover:scale-[1.03] active:scale-[0.98] shadow-sm hover:shadow-md"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="h-4 w-4 fill-current flex-shrink-0"
					viewBox="0 0 20 20"
				>
					<path
						d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
					></path>
					<path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
					></path>
				</svg>
				<span>Email me!</span>
			</a>
		</div>

		<!-- Thin Divider -->
		<div class="w-12 h-px bg-ea-border mb-5"></div>

		<!-- 1-2 Sentence Bio -->
		<p
			class="max-w-[320px] font-ea-body text-sm leading-relaxed text-ea-text-secondary/90 italic flex-grow"
		>
			{person.bio}
		</p>
	</div>
</article>
