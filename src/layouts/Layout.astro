---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Effective Altruism Durham",
  description = "We represent the Effective Altruism movement in Durham University. We empower students who want to make a change through our programmes, events, and community.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Self-hosted fonts (astro.config.mjs `fonts`). Not preloaded: the local provider can't
         tell the latin and latin-ext files apart, so a preload would also fetch latin-ext,
         which this English-only site never uses. Astro's metric-matched fallbacks keep the
         swap from shifting layout. -->
    <Font cssVariable="--font-raleway" />
    <Font cssVariable="--font-roboto-slab" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
