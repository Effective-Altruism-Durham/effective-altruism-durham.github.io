---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getStoryblokSiteSettings } from "../data/storyblokSiteSettings";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Effective Altruism Durham",
  description = "We represent the Effective Altruism movement in Durham University. We empower students who want to make a change through our programmes, events, and community.",
} = Astro.props;

const siteSettings = await getStoryblokSiteSettings();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;600;700&family=Roboto+Slab:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader siteSettings={siteSettings} />
    <slot />
    <SiteFooter siteSettings={siteSettings} />
  </body>
</html>
